# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform APIs.
# Users configure this via the Secrets panel in the AI Studio UI.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JAZZCASH_MERCHANT_ID: Your JazzCash Merchant ID
JAZZCASH_MERCHANT_ID=""
# JAZZCASH_PASSWORD: Your JazzCash API Password
JAZZCASH_PASSWORD=""
# JAZZCASH_INTEGRITY_SALT: Your JazzCash Integrity Salt
JAZZCASH_INTEGRITY_SALT=""

# EASYPAISA_STORE_ID: Your EasyPaisa Store ID
EASYPAISA_STORE_ID=""
# EASYPAISA_HASH_KEY: Your EasyPaisa Hash Key
EASYPAISA_HASH_KEY=""
